# Copy to .env and fill in. .env is gitignored - never commit real credentials.

# ---------------------------------------------------------------------------
# AI / LLM provider
#
# The AI features work with any OpenAI-compatible endpoint. Leave LLM_BASE_URL
# empty to use OpenAI itself. Examples:
#   Ollama      LLM_BASE_URL=http://localhost:11434/v1     LLM_API_KEY=ollama
#   LM Studio   LLM_BASE_URL=http://localhost:1234/v1      LLM_API_KEY=lm-studio
#   vLLM        LLM_BASE_URL=http://localhost:8000/v1      LLM_API_KEY=token
#   DeepSeek    LLM_BASE_URL=https://api.deepseek.com/v1   LLM_API_KEY=...
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_API_KEY=...
# ---------------------------------------------------------------------------
ENABLE_AI=false
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4
LLM_VISION_MODEL=gpt-4o

# Legacy name, still used as a fallback when LLM_API_KEY is not set
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# TestRail
# ---------------------------------------------------------------------------
TESTRAIL_URL=
TESTRAIL_USERNAME=
TESTRAIL_API_KEY=
TESTRAIL_PROJECT_ID=
TESTRAIL_SUITE_ID=
# Close the test run when the suite finishes
TESTRAIL_CLOSE_RUN=false
# Optional: reuse an existing run instead of creating one
# TESTRAIL_RUN_ID=
# Optional: run a single case (used by npm run testrail:run:case)
# TESTRAIL_CASE_ID=

# ---------------------------------------------------------------------------
# Test target
# ---------------------------------------------------------------------------
BASE_URL=http://localhost:3000
